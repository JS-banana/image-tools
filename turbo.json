{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "public/models/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "test": {},
    "typecheck": {}
  },
  "globalEnv": [
    "BASE_PATH",
    "NEXT_PUBLIC_TOOLS",
    "MODEL_IDS"
  ],
  "globalDependencies": [
    "scripts/model-catalogs.mjs",
    "scripts/copy-ort.mjs",
    "packages/*/models.json"
  ]
}
