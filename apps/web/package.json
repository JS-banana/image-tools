{
  "name": "@img/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run prepare-assets && next dev",
    "copy-ort": "node ../../scripts/copy-ort.mjs",
    "build": "pnpm run prepare-assets && next build && node --experimental-strip-types ../../scripts/model-catalogs.mjs filter-export",
    "postinstall": "node ../../scripts/copy-ort.mjs",
    "start": "pnpm dlx serve@latest out",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare-assets": "node --experimental-strip-types ../../scripts/model-catalogs.mjs generate && node ../../scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@img/model-runtime": "workspace:*",
    "@img/ocr": "workspace:*",
    "@img/remove-bg": "workspace:*",
    "next": "16.3.0",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
